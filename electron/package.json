{
  "name": "dodoc-electron",
  "productName": "SoftGems",
  "version": "0.0.7",
  "description": "SoftGems Electron wrapper",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "debug": "electron --inspect=5858 . -- --debug --verbose",
    "debug-lr": "electronmon --inspect=5858 . -- --debug --verbose --livereload",
    "pack": "electron-builder --dir",
    "dist": "node -e \"console.log('Electron release generation is temporarily disabled.')\"",
    "dist:win-store": "node -e \"console.log('Electron release generation is temporarily disabled.')\"",
    "postinstall": "electron-builder install-app-deps"
  },
  "engines": {
    "node": "24.14.0",
    "npm": "*"
  },
  "electronmon": {
    "patterns": [
      "!../client/**",
      "!../tokens.json"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "40.8.5",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4"
  }
}
